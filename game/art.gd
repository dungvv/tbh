static var _cache := {}


static func tex(name: String) -> Texture2D:
	if _cache.has(name):
		return _cache[name]
	var path := "res://art/%s.png" % name
	var t: Texture2D = load(path) if ResourceLoader.exists(path) else _from_grid(SPRITES[name])
	_cache[name] = t
	return t


static func _from_grid(rows: Array) -> ImageTexture:
	var img := Image.create(rows[0].length(), rows.size(), false, Image.FORMAT_RGBA8)
	for y in rows.size():
		assert(rows[y].length() == img.get_width(), "row %d has wrong width" % y)
		for x in rows[y].length():
			var ch: String = rows[y][x]
			if ch != ".":
				img.set_pixel(x, y, PALETTE[ch])
	return ImageTexture.create_from_image(img)


static var _top_cache := {}


## First non-transparent row of a sprite, so UI can sit right above the visible art.
static func top_row(name: String) -> int:
	if not _top_cache.has(name):
		_top_cache[name] = tex(name).get_image().get_used_rect().position.y
	return _top_cache[name]
